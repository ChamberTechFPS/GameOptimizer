{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chamber Game Optimizer",
  "version": "1.0.0",
  "identifier": "net.chambertech.gameoptimizer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chamber Game Optimizer",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#111115"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com https://api.github.com; img-src 'self'; font-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../catalog.json*": "catalog/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
