{
  "name": "Fortnite",
  "slug": "fortnite",
  "platform": "epic",
  "detect": { "epicAppName": "Fortnite" },
  "targets": [
    {
      "template": "GameUserSettings.ini",
      "dest": "{localappdata}/FortniteGame/Saved/Config/WindowsClient/GameUserSettings.ini",
      "readOnlyAfterApply": true
    }
  ],
  "variables": ["refreshRate", "resolutionWidth", "resolutionHeight"]
}
