{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chamber game manifest",
  "type": "object",
  "required": ["name", "slug", "platform", "detect"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "platform": { "enum": ["steam", "epic", "riot", "battlenet", "ea", "other"] },
    "guideOnly": { "type": "boolean" },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steamAppId": { "type": "integer" },
        "epicAppName": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "customLabel": { "type": "string", "description": "Prompt shown when asking the user to pick this game's folder (for {custom} tokens)" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["template", "dest"],
        "additionalProperties": false,
        "properties": {
          "template": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*[A-Za-z0-9_-]$",
            "description": "Leaf filename inside the game folder — no separators or traversal"
          },
          "dest": {
            "type": "string",
            "pattern": "^\\{(localappdata|appdata|documents|steamuserdata|custom)\\}(/[A-Za-z0-9][A-Za-z0-9 ._()-]*)+$",
            "description": "Must be rooted at an allowlisted token; the engine re-validates at runtime"
          },
          "readOnlyAfterApply": { "type": "boolean" }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": { "enum": ["refreshRate", "resolutionWidth", "resolutionHeight"] },
      "description": "Only variables the engine actually produces (Get-SystemVariables)"
    }
  },
  "if": { "properties": { "guideOnly": { "const": true } }, "required": ["guideOnly"] },
  "then": { "not": { "required": ["targets"] } },
  "else": { "required": ["targets"] }
}
