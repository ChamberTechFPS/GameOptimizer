{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chamber game manifest",
  "type": "object",
  "required": ["name", "slug", "platform", "detect"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "platform": { "enum": ["steam", "epic", "riot", "other"] },
    "guideOnly": { "type": "boolean" },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steamAppId": { "type": "integer" },
        "epicAppName": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "customLabel": { "type": "string", "description": "Prompt shown when asking the user to pick this game's folder (for {custom} tokens)" }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["template", "dest"],
        "additionalProperties": false,
        "properties": {
          "template": { "type": "string" },
          "dest": { "type": "string" },
          "readOnlyAfterApply": { "type": "boolean" }
        }
      }
    },
    "variables": { "type": "array", "items": { "type": "string" } }
  }
}
