{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chamber Game Optimizer catalog",
  "type": "object",
  "required": ["catalogVersion", "games"],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "version", "files"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "sha256"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*[A-Za-z0-9_-]$" },
                "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
