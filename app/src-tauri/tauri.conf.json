{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chamber Game Optimizer",
  "version": "0.1.0",
  "identifier": "net.chambertech.gameoptimizer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chamber Game Optimizer",
        "width": 720,
        "height": 660,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "resources": {
      "../../engine/": "engine/",
      "../../games/": "games/",
      "../../catalog.json": "catalog.json"
    }
  }
}
